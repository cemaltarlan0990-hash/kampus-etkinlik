    "name": "Kampüs API",
    "description": "Sprint 8 · Kampüs Etkinlikleri REST API (MongoDB) için 6 istek. Sunucu: http://localhost:3000. Önce npm run seed, sonra npm run dev. 2. istek listedeki ilk etkinliğin _id'sini eventId değişkenine kaydeder; 3. istek onu kullanır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "eventId",
      "value": "6afd55496d283ef5baa6ddfd",
      "type": "string",
      "description": "GET /events listesinden bir _id. Her npm run seed'den sonra değişir; 2. istek otomatik günceller."
    }
  ],
  "item": [
    {
      "name": "1 · GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "description": "Beklenen: 200 · status ok + time + student (öğrenci numarası)"
      },
      "response": []
    },
    {
      "name": "2 · GET /events",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test(\"Her kayıtta _id ve createdAt var\", () => {",
              "  pm.expect(list.length).to.be.above(0);",
              "  pm.expect(list[0]).to.have.property(\"_id\");",
              "  pm.expect(list[0]).to.have.property(\"createdAt\");",
              "});",
              "if (list.length) pm.collectionVariables.set(\"eventId\", list[0]._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        },
        "description": "Beklenen: 200 · seed sonrası 6 kayıt; her kayıtta _id, createdAt ve updatedAt. İlk kaydın _id'si eventId değişkenine yazılır."
      },
      "response": []
    },
    {
      "name": "3 · GET /events/:id (listeden _id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/{{eventId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "{{eventId}}"]
        },
        "description": "Beklenen: 200 · tek etkinlik. {{eventId}} 2. istekte listeden alınır; seed tekrar çalıştıysa önce 2. isteği gönderin."
      },
      "response": []
    },
    {
      "name": "4 · GET /events/yok",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/yok",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events", "yok"]
        },
        "description": "Beklenen: 404 (500 değil) · { error: { message: \"Event not found\" } }"
      },
      "response": []
    },
    {
      "name": "5 · POST /events (tam body)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Git Atölyesi\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-12-01\",\n  \"capacity\": 30\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["events"]
        },
        "description": "Beklenen: 201 · yeni _id, createdAt ve updatedAt ile kayıt. Sunucuyu kapatıp açınca GET /events'te hâlâ görünür."
      },
      "response": []
    },
    {
      "name": "6 · POST /events (sadece title)",
      "request": {
